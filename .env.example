# Copiá este archivo como .env y completá los valores.

# Dueño de la base: solo lo usa "npm run migrar" para crear las tablas
DATABASE_URL_ADMIN=postgres://postgres:CLAVE_POSTGRES@localhost:5432/contable

# Rol de la aplicación. Inventá una clave: "npm run migrar" crea el rol con ella
DB_APP_PASSWORD=otra-clave-para-la-aplicacion
DATABASE_URL=postgres://contable_app:otra-clave-para-la-aplicacion@localhost:5432/contable

# Secreto para firmar las sesiones. Generá uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Primer administrador: se crea al arrancar si todavía no hay usuarios
ADMIN_USUARIO=admin
ADMIN_EMAIL=vos@estudio.com.py
ADMIN_NOMBRE=Tu Nombre
ADMIN_CLAVE=una-clave-de-al-menos-10-caracteres

PORT=3000
# true en producción, cuando el sistema se sirve por HTTPS
COOKIE_SEGURA=false
