# Copiá este archivo como .env (en esta misma carpeta nube/) y completá los valores. No lo subas a Git.

# Dominio con el que se entra al sistema (tiene que apuntar a la IP del servidor)
DOMINIO=partida.tudominio.com.py

# Clave del usuario postgres de la base (inventá una larga)
POSTGRES_PASSWORD=

# Clave del rol con el que trabaja la aplicación (otra distinta)
DB_APP_PASSWORD=

# Firma de las sesiones. Generá una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Administrador de la plataforma: se crea en el primer arranque. Da de alta los estudios.
ESTUDIO_NOMBRE=Administración de la plataforma
ADMIN_USUARIO=admin
ADMIN_EMAIL=vos@tudominio.com.py
ADMIN_NOMBRE=Tu Nombre
ADMIN_CLAVE=
